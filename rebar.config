{erl_opts, [
    debug_info,
    warnings_as_errors,
    warn_unused_vars,
    warn_shadow_vars,
    warn_unused_import,
    warn_obsolete_guard
]}.

{project_plugins, [
    rebar3_ex_doc,
    rebar3_hex
]}.

{profiles, [
    {test, [
        {deps, [
            {meck, "0.9.2"}
        ]},
        {erl_opts, [nowarn_export_all]},
        %% Enable distributed node for integration tests with Khepri/Ra
        {eunit_opts, [
            {sname, macula_mri_test}
        ]}
    ]},
    {lint, [
        {plugins, [{rebar3_lint, "5.0.4"}]}
    ]}
]}.

{elvis, [
    {rulesets, #{
        macula_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [ #{files => ["src/**/*.erl"], ruleset => macula_min} ]}
]}.

{dialyzer, [
    {warnings, [
        unknown,
        unmatched_returns,
        error_handling
    ]},
    {plt_apps, top_level_deps},
    {plt_extra_apps, [khepri, ra]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{hex, [
    {doc, #{provider => ex_doc}}
]}.

{ex_doc, [
    {source_url, <<"https://github.com/macula-io/macula-mri-khepri">>},
    {extras, [
        <<"README.md">>,
        <<"CHANGELOG.md">>,
        <<"LICENSE">>,
        <<"guides/mri-system-guide.md">>
    ]},
    {main, <<"README.md">>},
    {api_reference, true},
    {assets, #{<<"assets">> => <<"assets">>}}
]}.
