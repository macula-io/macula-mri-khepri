{erl_opts, [
    debug_info
]}.

{deps, [
    {khepri, "0.17.2"},
    %% macula core for MRI behaviours (parse, validate, format)
    {macula, "~> 7.0"}
]}.

{shell, [
    {apps, [macula_mri_khepri]}
]}.

{project_plugins, [
    rebar3_ex_doc,
    rebar3_hex
]}.

{hex, [
    {doc, #{provider => ex_doc}}
]}.

{ex_doc, [
    {source_url, <<"https://github.com/macula-io/macula-mri-khepri">>},
    {extras, [
        <<"README.md">>,
        <<"CHANGELOG.md">>,
        <<"LICENSE">>,
        <<"guides/mri-system-guide.md">>
    ]},
    {main, <<"README.md">>},
    {api_reference, true},
    {assets, #{<<"assets">> => <<"assets">>}}
]}.
